      "id": "tcp-three-way",
      "type": "sequence",
      "chapterId": "tcp",
      "title": "TCP 三次握手：两端状态并不同时变化",
      "knowledgeNodeIds": [
        "tcp",
        "tcp-syn",
        "tcp-syn-ack",
        "tcp-ack"
      ],
      "explanation": "x、y 表示各自初始序号；SYN 各占一个序号，确认号因此加一",
      "result": "最后 ACK 到达后，两端才都进入 ESTABLISHED",
      "timing": {
        "read": 3,
        "act": 12,
        "hold": 4
      },
      "actors": [
        "browser",
        "server"
      ],
      "actions": [
        {
          "id": "client-sending",
          "kind": "state",
          "at": 0,
          "duration": 0.1,
          "set": {
            "browser-state": "SYN-SENT"
          },
          "expect": {
            "browser-state": "CLOSED"
          },
          "label": "客户端主动打开，发送 SYN"
        },
        {
          "id": "syn",
          "kind": "transfer",
          "from": "browser",
          "to": "server",
          "at": 0.1,
          "duration": 3.9,
          "label": "SYN · seq=x",
          "set": {
            "server-state": "SYN-RECEIVED"
          },
          "expect": {
            "server-state": "LISTEN"
          }
        },
        {
          "id": "syn-ack",
          "kind": "transfer",
          "from": "server",
          "to": "browser",
          "at": 4,
          "duration": 4,
          "label": "SYN + ACK · seq=y, ack=x+1",
          "set": {
            "browser-state": "ESTABLISHED"
          },
          "expect": {
            "browser-state": "SYN-SENT"
          }
        },
        {
          "id": "ack",
          "kind": "transfer",
          "from": "browser",
          "to": "server",
          "at": 8,
          "duration": 4,
          "label": "ACK · seq=x+1, ack=y+1",
          "set": {
            "server-state": "ESTABLISHED"
          },
          "expect": {
            "server-state": "SYN-RECEIVED"
          }
        }
      ]
    },
