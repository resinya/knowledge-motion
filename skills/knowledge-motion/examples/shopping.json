    {"id":"pick","label":"仓库拣货","caption":"按照订单取出对应商品","result":"商品与订单完成匹配","color":"cyan","diagram":{"nodes":[{"id":"stock","label":"货架","icon":"database"},{"id":"goods","label":"待发商品","icon":"package"}],"edges":[{"from":"stock","to":"goods","label":"拣出商品"}]}},
